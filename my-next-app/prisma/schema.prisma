// Prisma 7+ 仕様: datasourceにurlは書かない
datasource db {
  provider = "postgresql"
	url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. AppStateの boardOrder を管理するための最上位
model AppConfig {
  id          Int      @id @default(1)
  boardOrder  String[] // ボードの並び順（IDの配列）
}

// 2. ボード情報
model Board {
  id        String   @id @default(uuid())
  title     String?
  projectId String?
  
  // Cardとの1対多のリレーション
  cards     Card[]
}

// 3. カード（タスク）情報
model Card {
  id         String   @id @default(uuid())
  title      String
  details    String
  status     String   // "active" | "archived" (Enumにするのもアリ)
  progress   String   // "todo" | "doing" | "done"
  startAt    DateTime?
  dueAt      DateTime?
  simpleView Boolean  @default(false)

  // 親子関係（自己参照リレーション）
  parentId   String?
  parent     Card?    @relation("CardHierarchy", fields: [parentId], references: [id])
  children   Card[]   @relation("CardHierarchy")

  // ボードとのリレーション
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}