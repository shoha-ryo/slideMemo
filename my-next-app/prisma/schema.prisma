datasource db {
  provider = "postgresql"
	url      = env("DATABASE_URL") // ver6.x.xだから必要みたい
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  projects  Project[] // 1人のユーザーは複数のプロジェクトを持つ
}

model Project {
  id          String      @id @default(cuid())
	title       String
	userId      String   // プロジェクトの作成者
  boardOrder  String[] // ボードの並び順（IDの配列）
}

model Board {
  id        String   @id @default(uuid())
  title     String
  projectId String
  cardIds   String[]
  cards     Card[]
}

enum Status {
  active
  archived
}
enum Progress {
  todo
  doing
  done
}
model Card {
  id         String   @id @default(uuid())
  title      String
  details    String

  childrenIds String[]
  children   Card[]   @relation("CardHierarchy")
  parentId   String?
  parent     Card?    @relation("CardHierarchy", fields: [parentId], references: [id])
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

	progress   Progress @default(todo)
  status     Status   @default(active)
  simpleView Boolean  @default(false)
  startAt    DateTime?
  dueAt      DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}