datasource db {
  provider  = "postgresql"
	url       = env("DATABASE_URL") // ver6.x.xだから必要みたい
	directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id        String    @id // firebaseのuidで管理
  email     String    @unique
  name      String?
  projects  Project[] // 1人のユーザーは複数のプロジェクトを持つ
}

model Project {
  id          String      @id @default(cuid())
	title       String
	userId      String   // プロジェクトの作成者
	user        User     @relation(fields: [userId], references: [id])
	activityLog ActivityLog[]
  boardOrder  String[] // ボードの並び順（IDの配列）
	boards      Board[]
	cards       Card[]
	labels      Label[]
	createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
}

model Board {
  id         String   @id @default(uuid())
  title      String
  projectId  String
	project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cardIds    String[]
  cards      Card[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())
}

enum Status {
  active
  archived
}
enum Progress {
  todo
  doing
  done
}
model Card {
  id          String    @id @default(uuid())
  title       String
  details     String

	projectId   String
	project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  childrenIds String[]
  children    Card[]    @relation("CardHierarchy")
  parentId    String?
  parent      Card?     @relation("CardHierarchy", fields: [parentId], references: [id])
  boardId     String
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

	progress    Progress  @default(todo)
  status      Status    @default(active)
  simpleView  Boolean   @default(false)
	labels      Label[]   @relation("CardToLabel")
  startAt     DateTime?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String
	project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityId   String   // 変更されたカードやボードのID
  entityType String   // "CARD" | "BOARD | "LABEL"
  action     String   // "CREATE" | "UPDATE" | "DELETE"

  // 誰が変えたか（将来的な認証導入時に役立つ）
  // userId    String?

  // 更新内容の要約（任意：Pusherの軽量化やログ表示用）
  // payload   Json?

  createdAt DateTime @default(now()) // 変更日

  @@index([projectId, createdAt])
}

model Label {
  id        String   @id @default(uuid())
  name      String
  color     String

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  cards     Card[]   @relation("CardToLabel") // 多対多のリレーション
  createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt @default(now())
}