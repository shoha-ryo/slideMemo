datasource db {
  provider = "postgresql"
	url      = env("DATABASE_URL") // ver6.x.xだから必要みたい
}

generator client {
  provider = "prisma-client-js"
}

// 1. AppStateの boardOrder を管理するための最上位
model AppConfig {
  id          Int      @id @default(1)
  boardOrder  String[] // ボードの並び順（IDの配列）
}

// 2. ボード情報
model Board {
  id        String   @id @default(uuid())
  title     String?
  projectId String?

  // 追加：カードの並び順（IDの配列）を直接保存する
  cardIds   String[]
  cards     Card[]
}



enum Status {
  active
  archived
}

enum Progress {
  todo
  doing
  done
}

model Card {
  id         String   @id @default(uuid())
  title      String
  details    String
  status     Status   @default(active)
  progress   Progress @default(todo)
  startAt    DateTime?
  dueAt      DateTime?
  simpleView Boolean  @default(false)

  childrenIds String[]

  parentId   String?
  parent     Card?    @relation("CardHierarchy", fields: [parentId], references: [id])
  children   Card[]   @relation("CardHierarchy")

  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}